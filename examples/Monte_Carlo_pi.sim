! MONTE CARLO PI - ESTIMATE PI BY DRAWING 100000 SEEDED UNIFORM
! POINTS IN THE UNIT SQUARE AND COUNTING HITS INSIDE THE QUARTER
! CIRCLE; DETERMINISTIC BECAUSE THE GENERATOR IS SEEDED ;
BEGIN
    INTEGER SEED;
    INTEGER N, K, HITS;
    REAL X, Y, ESTIMATE;

    SEED := 12345;
    N := 100000;
    HITS := 0;

    FOR K := 1 STEP 1 UNTIL N DO
    BEGIN
        X := UNIFORM(0.0, 1.0, SEED);
        Y := UNIFORM(0.0, 1.0, SEED);
        IF X*X + Y*Y <= 1.0 THEN HITS := HITS + 1
    END;

    ESTIMATE := 4.0 * HITS / N;

    OUTTEXT("POINTS DRAWN:  "); OUTINT(N, 0); OUTIMAGE;
    OUTTEXT("HITS INSIDE:   "); OUTINT(HITS, 0); OUTIMAGE;
    OUTTEXT("PI ESTIMATE: "); OUTFIX(ESTIMATE, 3, 8); OUTIMAGE;
    OUTTEXT("TRUE PI:     "); OUTFIX(PI, 3, 8); OUTIMAGE
END.
