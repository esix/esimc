! Bubble sort using SWITCH for direction control
BEGIN
    INTEGER ARRAY A(1:10);
    INTEGER I, J, T;

    A(1):=5; A(2):=3; A(3):=8; A(4):=1; A(5):=9;
    A(6):=2; A(7):=7; A(8):=4; A(9):=6; A(10):=0;

    FOR I := 1 STEP 1 UNTIL 9 DO
        FOR J := 1 STEP 1 UNTIL 10-I DO
            IF A(J) > A(J+1) THEN
            BEGIN
                T := A(J); A(J) := A(J+1); A(J+1) := T;
            END;

    FOR I := 1 STEP 1 UNTIL 10 DO BEGIN
        OUTINT(A(I), 3);
    END;
    OUTIMAGE;
END.
