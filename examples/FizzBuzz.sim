! FIZZBUZZ - CLASSIC 1..30 USING MOD:
! PRINT FIZZ FOR MULTIPLES OF 3, BUZZ FOR MULTIPLES OF 5,
! FIZZBUZZ FOR BOTH, OTHERWISE THE NUMBER ITSELF ;
BEGIN
    INTEGER I;

    FOR I := 1 STEP 1 UNTIL 30 DO
    BEGIN
        IF MOD(I, 15) = 0 THEN OUTTEXT("FizzBuzz")
        ELSE IF MOD(I, 3) = 0 THEN OUTTEXT("Fizz")
        ELSE IF MOD(I, 5) = 0 THEN OUTTEXT("Buzz")
        ELSE OUTINT(I, 0);
        OUTIMAGE
    END
END.
