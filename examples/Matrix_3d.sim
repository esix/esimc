COMMENT 3D arrays: fill a 3x3x3 cube with i*100+j*10+k, then sum it and read
        back a few cells;
BEGIN
    INTEGER ARRAY CUBE(1:3, 1:3, 1:3);
    INTEGER I, J, K, TOTAL;
    FOR I := 1 STEP 1 UNTIL 3 DO
      FOR J := 1 STEP 1 UNTIL 3 DO
        FOR K := 1 STEP 1 UNTIL 3 DO
          CUBE(I, J, K) := I * 100 + J * 10 + K;
    OUTTEXT("CUBE(1,1,1) = "); OUTINT(CUBE(1,1,1), 0); OUTIMAGE;
    OUTTEXT("CUBE(2,3,1) = "); OUTINT(CUBE(2,3,1), 0); OUTIMAGE;
    OUTTEXT("CUBE(3,3,3) = "); OUTINT(CUBE(3,3,3), 0); OUTIMAGE;
    TOTAL := 0;
    FOR I := 1 STEP 1 UNTIL 3 DO
      FOR J := 1 STEP 1 UNTIL 3 DO
        FOR K := 1 STEP 1 UNTIL 3 DO
          TOTAL := TOTAL + CUBE(I, J, K);
    OUTTEXT("TOTAL = "); OUTINT(TOTAL, 0); OUTIMAGE;
END.
